#include <winver.h>
#include "../include/resource.h"

APP_ICON            ICON    "icon.ico"
1                   24      "app.manifest"

/* Official signed driver installers (Nefarius Software Solutions e.U.) */
IDR_VIGEM_SETUP     RCDATA  "../drivers/ViGEmBus_1.22.0_x64_x86_arm64.exe"
IDR_HIDHIDE_SETUP   RCDATA  "../drivers/HidHide_1.5.230_x64.exe"

VS_VERSION_INFO     VERSIONINFO
FILEVERSION         1,0,0,0
PRODUCTVERSION      1,0,0,0
FILETYPE            VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "StadiaPad - Stadia controller as Xbox 360 gamepad"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "OriginalFilename", "StadiaPad.exe"
            VALUE "ProductName",      "StadiaPad"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
